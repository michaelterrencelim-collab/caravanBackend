# Required for the Turso/libSQL database connection.
TURSO_LINK=libsql://your-database.turso.io
TURSO_TOKEN=replace-with-your-turso-auth-token

# Use a long, random value. Never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

PORT=3000
NODE_ENV=development
# Optional additional browser origins for credentialed cross-origin API calls.
CORS_ORIGINS=

# Optional: Google sign-in. Register GOOGLE_CALLBACK_URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:8100

# Optional: Gmail SMTP for order confirmation emails.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Optional: PayPal sandbox configuration.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API=https://api-m.sandbox.paypal.com
